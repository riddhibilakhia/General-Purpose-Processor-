`timescale 1 ps/ 1 ps
module alu_diagr_vlg_sample_tst(
	A,
	B,
	clock,
	data_in,
	dcoder_enable,
	reset,
	sampler_tx
);
input [7:0] A;
input [7:0] B;
input  clock;
input  data_in;
input  dcoder_enable;
input  reset;
output sampler_tx;

reg sample;
time current_time;
always @(A or B or clock or data_in or dcoder_enable or reset)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

