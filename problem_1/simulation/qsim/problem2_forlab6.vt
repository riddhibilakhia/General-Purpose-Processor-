		$display ("ERROR! Vector Mismatch for output port neg_first_4_disp[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", neg_first_4_disp_expected_prev);
		$display ("     Real value = %b", neg_first_4_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_neg_first_4_disp_exp[6] = neg_first_4_disp_expected_prev[6];
	end
	if (
		( studentid_disp_expected_prev[0] !== 1'bx ) && ( studentid_disp_prev[0] !== studentid_disp_expected_prev[0] )
		&& ((studentid_disp_expected_prev[0] !== last_studentid_disp_exp[0]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[0] = studentid_disp_expected_prev[0];
	end
	if (
		( studentid_disp_expected_prev[1] !== 1'bx ) && ( studentid_disp_prev[1] !== studentid_disp_expected_prev[1] )
		&& ((studentid_disp_expected_prev[1] !== last_studentid_disp_exp[1]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[1] = studentid_disp_expected_prev[1];
	end
	if (
		( studentid_disp_expected_prev[2] !== 1'bx ) && ( studentid_disp_prev[2] !== studentid_disp_expected_prev[2] )
		&& ((studentid_disp_expected_prev[2] !== last_studentid_disp_exp[2]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[2] = studentid_disp_expected_prev[2];
	end
	if (
		( studentid_disp_expected_prev[3] !== 1'bx ) && ( studentid_disp_prev[3] !== studentid_disp_expected_prev[3] )
		&& ((studentid_disp_expected_prev[3] !== last_studentid_disp_exp[3]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[3] = studentid_disp_expected_prev[3];
	end
	if (
		( studentid_disp_expected_prev[4] !== 1'bx ) && ( studentid_disp_prev[4] !== studentid_disp_expected_prev[4] )
		&& ((studentid_disp_expected_prev[4] !== last_studentid_disp_exp[4]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[4] = studentid_disp_expected_prev[4];
	end
	if (
		( studentid_disp_expected_prev[5] !== 1'bx ) && ( studentid_disp_prev[5] !== studentid_disp_expected_prev[5] )
		&& ((studentid_disp_expected_prev[5] !== last_studentid_disp_exp[5]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[5] = studentid_disp_expected_prev[5];
	end
	if (
		( studentid_disp_expected_prev[6] !== 1'bx ) && ( studentid_disp_prev[6] !== studentid_disp_expected_prev[6] )
		&& ((studentid_disp_expected_prev[6] !== last_studentid_disp_exp[6]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port studentid_disp[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", studentid_disp_expected_prev);
		$display ("     Real value = %b", studentid_disp_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_studentid_disp_exp[6] = studentid_disp_expected_prev[6];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module alu_diagr_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [7:0] A;
reg [7:0] B;
reg clock;
reg data_in;
reg dcoder_enable;
reg reset;
// wires                                               
wire [6:0] first_4_disp;
wire [6:0] last_4_disp2;
wire [6:0] neg_first_4_disp;
wire [6:0] studentid_disp;

wire sampler;                             

// assign statements (if any)                          
alu_diagr i1 (
// port map - connection between master ports and signals/registers   
	.A(A),
	.B(B),
	.clock(clock),
	.data_in(data_in),
	.dcoder_enable(dcoder_enable),
	.first_4_disp(first_4_disp),
	.last_4_disp2(last_4_disp2),
	.neg_first_4_disp(neg_first_4_disp),
	.reset(reset),
	.studentid_disp(studentid_disp)
);
// A[ 7 ]
initial
begin
	A[7] = 1'b0;
end 
// A[ 6 ]
initial
begin
	A[6] = 1'b0;
end 
// A[ 5 ]
initial
begin
	A[5] = 1'b0;
end 
// A[ 4 ]
initial
begin
	A[4] = 1'b0;
end 
// A[ 3 ]
initial
begin
	A[3] = 1'b0;
end 
// A[ 2 ]
initial
begin
	A[2] = 1'b0;
end 
// A[ 1 ]
initial
begin
	A[1] = 1'b0;
end 
// A[ 0 ]
initial
begin
	A[0] = 1'b0;
end 
// B[ 7 ]
initial
begin
	B[7] = 1'b0;
end 
// B[ 6 ]
initial
begin
	B[6] = 1'b0;
end 
// B[ 5 ]
initial
begin
	B[5] = 1'b0;
end 
// B[ 4 ]
initial
begin
	B[4] = 1'b0;
end 
// B[ 3 ]
initial
begin
	B[3] = 1'b0;
end 
// B[ 2 ]
initial
begin
	B[2] = 1'b0;
end 
// B[ 1 ]
initial
begin
	B[1] = 1'b0;
end 
// B[ 0 ]
initial
begin
	B[0] = 1'b0;
end 

// clock
initial
begin
	repeat(12)
	begin
		clock = 1'b0;
		clock = #40000 1'b1;
		# 40000;
	end
	clock = 1'b0;
end 

// data_in
initial
begin
	data_in = 1'b1;
end 

// dcoder_enable
initial
begin
	dcoder_enable = 1'b1;
end 

// reset
initial
begin
	reset = 1'b1;
end 

alu_diagr_vlg_sample_tst tb_sample (
	.A(A),
	.B(B),
	.clock(clock),
	.data_in(data_in),
	.dcoder_enable(dcoder_enable),
	.reset(reset),
	.sampler_tx(sampler)
);

alu_diagr_vlg_check_tst tb_out(
	.first_4_disp(first_4_disp),
	.last_4_disp2(last_4_disp2),
	.neg_first_4_disp(neg_first_4_disp),
	.studentid_disp(studentid_disp),
	.sampler_rx(sampler)
);
endmodule

