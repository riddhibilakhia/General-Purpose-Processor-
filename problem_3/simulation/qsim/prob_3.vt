alu_vlg_sample_tst tb_sample (
	.A(A),
	.B(B),
	.clock(clock),
	.OP(OP),
	.reset(reset),
	.student_id(student_id),
	.sampler_tx(sampler)
);

alu_vlg_check_tst tb_out(
	.result(result),
	.sampler_rx(sampler)
);
endmodule

